{
  "name": "trim",
  "version": "2.0.0",
  "description": "Trim",
  "main": "main.js",
  "author": "xiaoxu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test-features.js",
    "test:features": "node test-features.js",
    "prebuild": "node scripts/gen-fallback.js",
    "prebuild:dir": "node scripts/gen-fallback.js",
    "prebuild:portable": "node scripts/gen-fallback.js",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.xiaoxu.trim",
    "productName": "Trim",
    "copyright": "Copyright © 2026 xiaoxu",
    "description": "审查 8-1：安装器由兄弟目录 TuneForge goujian/trim-installer 的 Tauri 工程承担（npm run sync:resources 同步 win-unpacked）；本配置仅产出 portable 便携包，build:dir 为开发用免打包目录输出。",
    "directories": {
      "output": "build-release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/assets/ico/source.png",
      "!src/assets/ico/source_squared.png",
      "!src/assets/ico/icon_*.png",
      "src/assets/ico/*.ico",
      "readme.md",
      "package.json"
    ],
    "asarUnpack": [
      "src/assets/fonts/**"
    ],
    "extraResources": [
      {
        "from": "native-scanner/target/release/finder.exe",
        "to": "finder/finder.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/ico/Trim.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {}
}
