{
  "name": "trim",
  "version": "2.7.0",
  "description": "Trim",
  "main": "main.js",
  "author": "xiaoxu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoxu1642/Trim.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test-features.js",
    "test:features": "node test-features.js",
    "prebuild": "node scripts/gen-fallback.js",
    "prebuild:dir": "node scripts/gen-fallback.js",
    "prebuild:portable": "node scripts/gen-fallback.js",
    "prebuild:setup": "node scripts/gen-fallback.js",
    "prerelease": "node scripts/gen-fallback.js",
    "build": "electron-builder --win --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:setup": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.xiaoxu.trim",
    "productName": "Trim",
    "copyright": "Copyright © 2026 xiaoxu",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "build-release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/assets/ico/source.png",
      "!src/assets/ico/source_squared.png",
      "!src/assets/ico/icon_*.png",
      "!src/assets/ico/.workbuddy/**",
      "src/assets/ico/*.ico",
      "readme.md",
      "package.json"
    ],
    "asarUnpack": [
      "src/assets/fonts/**"
    ],
    "extraResources": [
      {
        "from": "native-scanner/target/release/finder.exe",
        "to": "finder/finder.exe"
      },
      {
        "from": "scripts/TrimFastSize.dll",
        "to": "fastsize/TrimFastSize.dll"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xiaoxu1642",
        "repo": "Trim",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/ico/Trim.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trim",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
